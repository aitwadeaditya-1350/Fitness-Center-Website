<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Membermaster.master.cs" Inherits="Admin_Member_Membermaster" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
    <style type="text/css">
        .auto-style1 {
            width: 100%;
        }
        .auto-style2 {
            height: 29px;
        }
        .auto-style3 {
            height: 26px;
        }
    </style>
</head>
<body>
   
    <form id="form1" runat="server">
        <table class="auto-style1">
            <tr>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td class="auto-style3">
                    <asp:Menu ID="Menu1" runat="server" Orientation="Horizontal" RenderingMode="Table" Width="100%">
                        <Items>
                            <asp:MenuItem Text="Home" Value="Home"></asp:MenuItem>
                            <asp:MenuItem Text="Courses" Value="Courses"></asp:MenuItem>
                            <asp:MenuItem Text="Products" Value="Products"></asp:MenuItem>
                            <asp:MenuItem Text="Cart" Value="Cart"></asp:MenuItem>
                            <asp:MenuItem Text="Myorder" Value="Myorder"></asp:MenuItem>
                            <asp:MenuItem Text="Feedback" Value="Feedback"></asp:MenuItem>
                        </Items>
                    </asp:Menu>
                </td>
            </tr>
            <tr>
                <td class="auto-style2"></td>
            </tr>
            <tr>
                <td>
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </td>
            </tr>
        </table>
    </form>
   
</body>
</html>
